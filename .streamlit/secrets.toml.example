# Gemini key (optional). Without it the app still works: the deterministic engine answers alone.
# 1) Get a free key at https://aistudio.google.com/apikey
# 2) Copy this file to .streamlit/secrets.toml (same folder) and paste the key between the quotes.
#    secrets.toml is listed in .gitignore: never upload it to GitHub or send it by chat.
# Alternative: set the environment variable GEMINI_API_KEY instead of using this file.
# On Streamlit Community Cloud paste the line below in the app's Secrets box.
GEMINI_API_KEY = "paste-your-key-here"

